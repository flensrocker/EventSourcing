@host=localhost
@port=5188

### Commands
PUT http://{{host}}:{{port}}/api/todo/task/{{note.response.body.$.TaskId}}/complete
Content-Type: application/json

{
}

###
PUT http://{{host}}:{{port}}/api/todo/task/{{note.response.body.$.TaskId}}/dismiss
Content-Type: application/json

{
  "Reason": "I don't want to!"
}

###
# @name note
POST http://{{host}}:{{port}}/api/todo/task/note
Content-Type: application/json

{
  "Title": "My first Task!"
}

###
PUT http://{{host}}:{{port}}/api/todo/task/{{note.response.body.$.TaskId}}/reopen
