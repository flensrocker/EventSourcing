{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "paths": {
      "@flensrocker/event-sourcing-core": [
        "./src/EventSourcing.Frontend/Core/dist"
      ],
      "@flensrocker/to-do-angular": [
        "./samples/ToDo/src/Frontend/Angular/dist/to-do-angular"
      ],
      "@flensrocker/to-do-core": ["./samples/ToDo/src/Frontend/Core/dist"]
    }
  }
}
