{
  "name": "Aspire",
  "image": "mcr.microsoft.com/devcontainers/base:3-ubuntu24.04",
  "features": {
    "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/powershell:2": {}
  },
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },
  "remoteEnv": {
    "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust"
  },
  "remoteUser": "root",
  "postStartCommand": "aspire certs trust --non-interactive",
  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "csharpier.csharpier-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "humao.rest-client",
        "microsoft-aspire.aspire-vscode",
        "ms-dotnettools.csdevkit",
        "vitest.explorer"
      ]
    }
  }
}
